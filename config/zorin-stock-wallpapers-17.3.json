  "strategy": {
    "mode": "dpkg-divert",
    "package_purge": "prohibited",
    "reason": "Target apt simulation showed that purging the wallpaper packages also removes zorin-os-artwork and zorin-os-desktop and installs Ubuntu wallpaper packages. Keep the Zorin packages installed and divert only the audited wallpaper/catalog paths out of GNOME discovery locations.",
