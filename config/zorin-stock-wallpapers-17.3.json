{
  "schema_version": 2,
  "status": "Development",
  "evidence_date": "2026-09-04",
  "target": {
    "id": "zorin",
    "version": "17.3"
  },
  "replacement": {
    "user_background_dir": "~/.local/share/backgrounds/GoreeCloud-Zorin",
    "user_catalog": "~/.local/share/gnome-background-properties/goreecloud-zorin.xml",
    "expected_wallpaper_count": 30
