<svg xmlns="http://www.w3.org/2000/svg" width="3840" height="2160" viewBox="0 0 3840 2160" role="img" aria-labelledby="title desc">
  <title id="title">{{category}} — {{family}} {{mode_label}}</title>
  <desc id="desc">Glaze UI atmospheric wallpaper with layered cirrus ribbons, cold edge light, and a quiet central work field.</desc>
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop stop-color="{{canvas}}"/><stop offset="0.55" stop-color="{{deep}}"/><stop offset="1" stop-color="{{surface}}"/></linearGradient>
    <radialGradient id="glow" cx="0.78" cy="0.28" r="0.62"><stop stop-color="{{ice_blue}}" stop-opacity=".34"/><stop offset="1" stop-color="{{ice_blue}}" stop-opacity="0"/></radialGradient>
    <linearGradient id="mist" x1="0" y1="0" x2="1" y2="0"><stop stop-color="{{crystal_white}}" stop-opacity=".02"/><stop offset=".55" stop-color="{{glacier_blue}}" stop-opacity=".16"/><stop offset="1" stop-color="{{clear_sky_blue}}" stop-opacity=".02"/></linearGradient>
  </defs>
  <rect width="3840" height="2160" fill="url(#bg)"/><rect width="3840" height="2160" fill="url(#glow)"/>
  <path d="M-260 520C540 250 1280 300 1980 540S3240 820 4140 430V760C3290 1030 2670 970 1960 770S590 480-260 840Z" fill="url(#mist)"/>
  <path d="M-320 1040C520 790 1210 850 1900 1060S3180 1320 4140 980" fill="none" stroke="{{frost_white}}" stroke-opacity=".13" stroke-width="18" stroke-linecap="round"/>
  <path d="M-220 1390C650 1180 1280 1240 2040 1450S3290 1690 4040 1370" fill="none" stroke="{{glacier_blue}}" stroke-opacity=".12" stroke-width="6" stroke-linecap="round"/>
  <circle cx="3030" cy="480" r="340" fill="{{crystal_white}}" opacity=".055"/>
</svg>